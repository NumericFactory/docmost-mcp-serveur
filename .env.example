# Public base URL this server is reachable at (used to build the /mcp/<token> URL
# shown after setup). On Coolify this is the domain you attach to the service.
BASE_URL=https://mcp.tondomaine.com

# 32-byte key, hex-encoded (64 hex chars), used to encrypt stored Docmost
# credentials at rest in Redis. Generate with: openssl rand -hex 32
# Keep this secret — losing it makes stored credentials unrecoverable;
# leaking it lets an attacker decrypt every tenant's Docmost password/apiKey.
MASTER_KEY=

# Only needed if not using docker-compose's built-in redis service.
# REDIS_URL=redis://localhost:6379
